{
  "manifest_version": 3,
  "name": "ONE — Intentional Attention Bridge",
  "version": "1.0.0",
  "description": "Companion browser extension for ONE. Intent Firewall protection and Intentional Exceptions.",
  "icons": {
    "128": "one-icon.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://harshavardhankotu.github.io/one-intentional-attention/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ONE — One thing. Right now.",
    "default_icon": "one-icon.png"
  }
}
